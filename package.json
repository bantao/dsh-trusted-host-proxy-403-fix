{
  "name": "dsh-trusted-host-proxy-403-fix",
  "version": "0.4.1",
  "description": "For DSH 0.1.2+, skip the browser-cookie 401 on Hosts already admitted by --trusted-host (Access remains the identity layer) and keep reverse-proxy settings persistence. Not an authentication layer.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/trust.test.js && node --import ./test/register-dsh-fakes.js test/apply.test.js && node test/client.test.js",
    "pack": "npm pack"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "trusted-host",
    "proxy",
    "403"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roojay/dsh-trusted-host-proxy-403-fix.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
